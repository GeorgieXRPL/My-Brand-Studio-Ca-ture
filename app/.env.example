# Optional: default hub URL baked into the build.
# Production falls back to https://brand-studio-hub.fly.dev if this is unset.
# Local:
VITE_HUB_URL=http://localhost:8787

# Privy (https://dashboard.privy.io). Same app ID the hub verifies with PRIVY_APP_ID.
# These are public (baked into the client). On Vercel add them as Config, not Secret.
# VITE_PRIVY_APP_ID=
# Optional app client for this origin:
# VITE_PRIVY_CLIENT_ID=
