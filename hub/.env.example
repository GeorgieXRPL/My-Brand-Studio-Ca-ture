# Copy this file to ".env" and fill in your values.

# Your Anthropic API key (get one at https://console.anthropic.com/).
# Pay-as-you-go; typically pennies per draft.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Claude model to use for text (when provider = claude).
ANTHROPIC_MODEL=claude-sonnet-4-5

# xAI Grok text model (when provider = grok). Same XAI_API_KEY as Imagine.
# XAI_TEXT_MODEL=grok-4.3

# xAI Grok Imagine (optional). Studio "Generate clip / still" on Drafts → Film this.
# Get a key at https://console.x.ai/ — docs: https://docs.x.ai/developers/models
# XAI_API_KEY=xai-xxxxxxxx
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# XAI_IMAGE_MODEL=grok-imagine-image
# IMAGINE_MONTHLY_LIMIT=20

# A shared secret the phone app must send to talk to this hub.
# Make it long and random, e.g. run:  openssl rand -hex 24
HUB_TOKEN=change-me-to-a-long-random-string

# Port the hub listens on locally.
PORT=8787

# Comma-separated list of allowed web origins (your Vercel URL + local dev).
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://mybrandstudio.club,https://www.mybrandstudio.club,https://app.mybrandstudio.club

# Concurrent AI caps (1GB Fly VM). Raise later if you scale the machine.
# GENERATE_MAX_INFLIGHT=16
# IMAGINE_MAX_INFLIGHT=6

# Public URL of this hub (your tunnel). Used by "npm run qr" for phone pairing
# and as the OAuth redirect base for Google / X sign-in.
# HUB_PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Public URL of the web app; users are sent back here after Google sign-in.
# APP_URL=https://app.mybrandstudio.club

# Google sign-in. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application).
# Authorized redirect URI (must match exactly):
#   https://brand-studio-hub.fly.dev/api/auth/google/callback
# Authorized JavaScript origins: your app URLs (Vercel + mybrandstudio.club).
# Then: fly secrets set -a brand-studio-hub GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Privy sign-in (email, Google, wallet). Create an app at https://dashboard.privy.io
# Allow your app origins (http://localhost:5173 and https://app.mybrandstudio.club).
# Then: fly secrets set -a brand-studio-hub PRIVY_APP_ID=... PRIVY_APP_SECRET=...
# PRIVY_APP_ID=clxxxxxxxx
# PRIVY_APP_SECRET=xxxxxxxx
# Optional PEM verification key from Dashboard → Configuration → App settings
# (skips fetching JWKS on each cold start):
# PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Email the ops inbox when someone signs up or logs in (user list).
# Create a Resend account, verify mybrandstudio.club, then:
#   fly secrets set -a brand-studio-hub RESEND_API_KEY=re_...
# OWNER_NOTIFY_EMAIL=hello@mybrandstudio.club
# MAIL_FROM=Brand Studio <hello@mybrandstudio.club>
# LOGIN_NOTIFY_HOURS=12
# RESEND_API_KEY=re_xxxx

# Unified posting API (optional, internal). Enables IG/FB/TikTok/LinkedIn direct Post.
# Never expose the vendor name in the app UI.
# UNIFIED_API_KEY=your-provider-key
# UNIFIED_API_URL=https://api.ayrshare.com/api

# Stripe billing (optional). When set, Setup uses Checkout + Customer Portal.
# Create Products/Prices in Stripe Dashboard for Creator ($19) and Studio ($49).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_STUDIO=price_...
# APP_ORIGIN=https://app.mybrandstudio.club

# Ops admin console at /admin (Bearer ADMIN_TOKEN).
# ADMIN_TOKEN=long-random-secret
# ADMIN_EMAILS=you@example.com

# Crypto invoices + auto on-chain confirmation (admin Verify & credit still works).
# Same Solana address receives SOL + SPL USDC/USDT. Same Ethereum address receives ETH + ERC-20 USDC/USDT.
# CRYPTO_SOLANA_ADDRESS=YourSolanaWalletAddress
# CRYPTO_ETHEREUM_ADDRESS=0xYourEthereumWalletAddress
# CRYPTO_PAY_NOTE=Send the exact USD amount. No memo needed — auto-credited after confirmations.
# Optional RPC overrides (defaults: public mainnet endpoints):
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETH_RPC_URL=https://ethereum.publicnode.com
# CRYPTO_SOL_CONFIRMATIONS=32
# CRYPTO_ETH_CONFIRMATIONS=12
# CRYPTO_WATCH_INTERVAL_MS=60000
# CRYPTO_WATCH_DISABLED=1
# Legacy single-address fallback (optional):
# CRYPTO_PAY_TO=your-wallet-address
# CRYPTO_CHAIN=solana

# Clip voiceover uses the same XAI_API_KEY (Grok TTS: eve, ara, rex, sal, leo).
# TTS_LANGUAGE=en

# Requests per minute allowed per agent API key (default 60).
# AGENT_RATE_LIMIT=60
